# Set text files to use LF line endings in repo
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.env text eol=lf

# Treat images and binaries as binary
*.ico binary
*.png binary

# Mark requirements.txt as text
requirements.txt text

# Optional: linguist language override
*.py linguist-language=Python